# Enki Art: every setting the code reads. Copy to .env.local and fill in.
# REQUIRED = the app or a core flow breaks without it. FEATURE = that feature turns off. Everything else has a default.
# Never commit real values. Ask the team for the development ones: they point at the shared Supabase project.

# --- App ---------------------------------------------------------------------
# REQUIRED. This app's own origin: the issuer of the wallet JWT (must match Coinbase CDP's custom auth), page metadata, admin mail links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Origin for links in outgoing mail and the onramp return URL. Default: https://enki.gallery.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
# Brand name in the wallet sign-in message, checked by the server. Default: Enki. Leave unset rather than empty.
NEXT_PUBLIC_APP_NAME=
# Address the "Request access" button opens as mailto:. Default: hello@enki.gallery.
NEXT_PUBLIC_ACCESS_REQUEST_EMAIL=

# --- Database (Supabase) -------------------------------------------------------
# REQUIRED. https://<project-ref>.supabase.co
SUPABASE_URL=
# REQUIRED. The service_role key (Dashboard > Settings > API). Server only; bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sign in with Google and X (lib/auth/oauth.ts) ------------------------------
# FEATURE. Register these redirect URIs at the providers (NEXT_PUBLIC_APP_URL must be the host people browse,
# www or not): <NEXT_PUBLIC_APP_URL>/api/auth/oauth/google/callback and .../api/auth/oauth/x/callback. A provider
# whose pair is unset answers "not configured". X asks for no email (no terms or privacy pages yet): app type Web App.
# Run sql-to-run/32 (users.origin takes google and x) before setting them.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# OPTIONAL. Where the providers send the browser back when it is not NEXT_PUBLIC_APP_URL: a local run sets
# http://localhost:3008 (and registers it + /api/auth/oauth/<provider>/callback at the provider). Production leaves it unset.
OAUTH_APP_URL=

# --- Secrets for auth and encryption at rest -----------------------------------
# REQUIRED. Base64 of 32 random bytes (openssl rand -base64 32). Keys password hashes, MFA codes, step-up and passkey challenges.
# Never change it once accounts exist: every stored password stops working.
AUTH_PEPPER=
# REQUIRED. Base64 of 32 random bytes. The AES-256-GCM key for prompt bodies, generation records, MFA secrets and other fields at rest.
FIELD_ENCRYPTION_KEY_B64=
# After a key rotation: the old keys, decrypt only. Comma-separated kid:base64 pairs.
FIELD_ENCRYPTION_KEYS_RETIRED=
# Decrypt only: the pre-keyring prompt key, for prompts written before the keyring. Nothing new is written with it.
PROMPT_ENCRYPTION_KEY=

# --- Private beta --------------------------------------------------------------
# The gate code. Unset = the gate is off and any signed-in account gets in (the usual local setup).
TEAM_ACCESS_CODE=
# FEATURE email self-signup: "1" opens it. The landing page has its own switch (public/landing.html); open both together.
SIGNUP_OPEN=

# --- Wallets (Coinbase CDP) ----------------------------------------------------
# FEATURE embedded wallets for email accounts. The CDP project id (UUID).
NEXT_PUBLIC_CDP_PROJECT_ID=
# FEATURE embedded wallets. Base64 of a PKCS8 RSA-2048 key: node scripts/gen-wallet-jwt-key.mjs
WALLET_JWT_PRIVATE_KEY=
# The wallet JWT's audience, if CDP's custom auth expects another one. Default: NEXT_PUBLIC_CDP_PROJECT_ID.
WALLET_JWT_AUDIENCE=
# FEATURE the Coinbase buy and sell ramp in Settings > Payment. A CDP API key id and its secret.
CDP_API_KEY_ID=
CDP_SECRET_KEY=

# --- Passkeys --------------------------------------------------------------------
# FEATURE passkeys (sign-in factor and step-up). The exact origin passkeys come from. Default: http://localhost:3008.
WEBAUTHN_ORIGIN=http://localhost:3000
# The domain passkeys are bound to. Default: the hostname of WEBAUTHN_ORIGIN.
WEBAUTHN_RP_ID=

# --- Payments (Solana) ---------------------------------------------------------
# REQUIRED for paid generation: solana-devnet or solana (mainnet). No default on the escrow path.
SOLANA_PAYMENT_CHAIN=solana-devnet
# The same chain for the browser, set equal to SOLANA_PAYMENT_CHAIN: it names the chain the phone wallet signs for
# (providers/SolanaWalletProvider.tsx). Unset is devnet.
NEXT_PUBLIC_SOLANA_PAYMENT_CHAIN=solana-devnet
# REQUIRED for paid generation: the escrow program's address on that cluster.
SOLANA_ESCROW_PROGRAM_ID=
# REQUIRED for paid generation, x402 and payouts: the server keypair that pays fees and co-signs (base58, or a 64-number JSON array).
SOLANA_FEE_PAYER_SECRET_KEY=
# FEATURE agent payments over x402: the wallet that receives the platform's share.
SOLANA_PLATFORM_WALLET=
# The chain x402 (agent) payments settle on: solana or solana-devnet. Default: SOLANA_PAYMENT_CHAIN. Its own setting so
# agents pay real USDC on mainnet while the escrow stays on devnet; on solana the fee payer needs mainnet SOL and
# SOLANA_RPC_URL should be a mainnet RPC (the public one rate-limits).
X402_PAYMENT_CHAIN=
# FEATURE the NFT picker (needs a DAS endpoint, e.g. Helius); also the first RPC on mainnet. May embed a key: treat as secret.
SOLANA_RPC_URL=
# A second mainnet RPC, tried when the first fails. Ignored on devnet.
SOLANA_RPC_URL_FALLBACK=

# --- Onramp (MoonPay) ------------------------------------------------------------
# FEATURE the MoonPay ramp: the publishable key (pk_test_ selects the sandbox) and the secret that signs the widget URL.
MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=

# --- Image models and checks ---------------------------------------------------
# REQUIRED. OpenAI: GPT-Image models and the image check every image passes (without it, generations answer 503 "not checked").
OPENAI_API_KEY=
# FEATURE Nano Banana Pro on its primary host (Google AI Studio key).
GOOGLE_GEMINI_API_KEY=
# FEATURE the fallback host for Nano Banana Pro and GPT-Image-2.
WAVESPEED_API_KEY=
# The free Flux model: a Pollinations token lifts the anonymous queue. Default: anonymous, throttled.
POLLINATIONS_TOKEN=
# The app id sent to Pollinations. Default: none.
POLLINATIONS_REFERRER=
# The free model's pixel budget. Default: 589824 (768x768).
POLLINATIONS_MAX_PIXELS=
# FEATURE the dice button (random variable values) through xAI.
XAI_API_KEY=
# The dice model. Default: grok-4-fast.
XAI_DICE_MODEL=
# FEATURE the admin Prompt Hunter: an X API v2 app-only bearer token (paid API).
X_API_BEARER_TOKEN=

# --- Storage ---------------------------------------------------------------------
# FEATURE our copy of every image and its WebP renditions, uploads, reference images. Vercel Blob read-write token.
BLOB_READ_WRITE_TOKEN=

# --- Mail ------------------------------------------------------------------------
# FEATURE all outgoing mail (password reset, MFA and step-up codes, invites, notices). A Resend API key.
RESEND_API_KEY=
# The sender. Default: Resend's test sender, which only reaches the Resend account owner.
EMAIL_FROM=

# --- Scheduled jobs and alerts -----------------------------------------------------
# FEATURE the crons in vercel.json (payment sweep, database health): the Bearer secret Vercel sends.
CRON_SECRET=
# FEATURE outage mails from the database health cron, and the day's mail when the free renders are used up. Comma-separated addresses.
OPS_ALERT_EMAILS=

# --- Free renders: the bot guard ---------------------------------------------------
# REQUIRED ON EVERY DEPLOYMENT for free renders, previews too: a free Turnstile widget (Cloudflare dashboard), its secret.
# Missing on a production build (NODE_ENV=production, which a Vercel preview is): free renders answer "paused". Only next
# dev skips the check, with one warning.
TURNSTILE_SECRET_KEY=
# The same widget's site key, public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# OPTIONAL. Free renders a UTC day over all accounts (SQL 63). Default: 200. 0 closes them.
FREE_RENDERS_PER_DAY=

# --- Build -----------------------------------------------------------------------
# A second build directory, so a trial build does not collide with the dev server's .next. Default: .next.
NEXT_DIST_DIR=
